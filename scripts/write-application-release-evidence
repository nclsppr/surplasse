#!/usr/bin/env python3
"""Write canonical evidence for one verified application-release artifact."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR / "lib"))

from application_release import ApplicationReleaseError, evidence_bytes  # noqa: E402
from vps_integration import sha256  # noqa: E402


def positive(value: str) -> int:
    parsed = int(value)
    if parsed < 1:
        raise argparse.ArgumentTypeError("positive integer required")
    return parsed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--artifact-reference", required=True)
    parser.add_argument("--release", required=True)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--created", required=True)
    parser.add_argument("--run-id", required=True, type=positive)
    parser.add_argument("--run-attempt", required=True, type=positive)
    parser.add_argument("--output", required=True)
    args = parser.parse_args()
    try:
        result = evidence_bytes(
            artifact_reference=args.artifact_reference,
            release=Path(args.release).read_bytes(),
            revision=args.revision,
            created=args.created,
            run_id=args.run_id,
            run_attempt=args.run_attempt,
        )
        output = Path(args.output)
        if output.exists() or output.is_symlink():
            raise ApplicationReleaseError("evidence output must not exist")
        output.write_bytes(result)
    except (ApplicationReleaseError, OSError, ValueError) as exc:
        print(f"application release evidence failed: {exc}", file=sys.stderr)
        return 1
    print(f"application release evidence written: {args.output} ({sha256(result)})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
