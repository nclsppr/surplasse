#!/usr/bin/env python3
"""Verify the published OCI manifest for an application release."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR / "lib"))

from application_release import ApplicationReleaseError, validate_manifest  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", required=True)
    parser.add_argument("--expected-digest", required=True)
    parser.add_argument("--release", required=True)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--created", required=True)
    args = parser.parse_args()
    try:
        validate_manifest(
            Path(args.manifest).read_bytes(),
            expected_digest=args.expected_digest,
            release=Path(args.release).read_bytes(),
            revision=args.revision,
            created=args.created,
        )
    except (ApplicationReleaseError, OSError) as exc:
        print(
            f"application release manifest verification failed: {exc}", file=sys.stderr
        )
        return 1
    print(f"application release OCI manifest verified: {args.expected_digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
