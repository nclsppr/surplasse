#!/usr/bin/env python3
"""Wait for stable green push gates for the exact canonical main revision."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR / "lib"))

from release_gate import GateError, GitHubClient, wait_for_gates  # noqa: E402


def positive(value: str) -> int:
    parsed = int(value)
    if parsed < 1:
        raise argparse.ArgumentTypeError("positive integer required")
    return parsed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--repository", default=os.environ.get("GITHUB_REPOSITORY", ""))
    parser.add_argument("--current-run-id", required=True, type=positive)
    parser.add_argument("--timeout", type=positive, default=2700)
    parser.add_argument("--poll-seconds", type=positive, default=15)
    parser.add_argument("--stable-polls", type=positive, default=2)
    parser.add_argument("--output", required=True)
    args = parser.parse_args()
    try:
        client = GitHubClient(
            token=os.environ.get("GH_TOKEN", ""), repository=args.repository
        )
        snapshot = wait_for_gates(
            client=client,
            revision=args.revision,
            current_run_id=args.current_run_id,
            timeout_seconds=args.timeout,
            poll_seconds=args.poll_seconds,
            stable_polls=args.stable_polls,
        )
        output = Path(args.output)
        if output.exists() or output.is_symlink():
            raise GateError("gate evidence output must not exist")
        output.write_bytes(snapshot.evidence())
    except (GateError, OSError, ValueError) as exc:
        print(f"release gate failed: {exc}", file=sys.stderr)
        return 1
    print(f"same-revision release gates are stable and green for {args.revision}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
