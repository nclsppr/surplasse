#!/usr/bin/env python3
"""Resolve five exact image digests and verify their GitHub attestations."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR / "lib"))

from vps_image_resolver import (  # noqa: E402
    ImageResolutionError,
    resolve_images,
    resolved_images_bytes,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--output", required=True)
    parser.add_argument("--github-output")
    args = parser.parse_args()
    try:
        result = resolved_images_bytes(resolve_images(args.revision))
        output = Path(args.output)
        if output.exists() or output.is_symlink():
            raise ImageResolutionError("resolved image output must not exist")
        output.write_bytes(result)
        os.chmod(output, 0o600)
        if args.github_output:
            github_output = Path(args.github_output)
            if github_output.is_symlink() or not github_output.is_file():
                raise ImageResolutionError(
                    "GitHub output must be an existing regular file"
                )
            with github_output.open("a", encoding="utf-8") as destination:
                destination.write(f"component_images={output}\n")
    except (ImageResolutionError, OSError) as exc:
        print(f"image resolution failed: {exc}", file=sys.stderr)
        return 1
    print(f"verified image references written to {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
