{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
  ],
  timezone: "Europe/Paris",
  schedule: ["* 0-5 * * 1"],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Mises à jour Renovate",
  branchConcurrentLimit: 3,
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  automerge: false,
  semanticCommits: "disabled",
  commitMessagePrefix: "deps:",
  commitMessageAction: "mets à jour",
  vulnerabilityAlerts: {
    enabled: true,
  },
  customManagers: [
    {
      customType: "regex",
      description: "Update the Renovate configuration validator",
      managerFilePatterns: ["/^package\\.json$/"],
      matchStrings: [
        "\\\"renovate:check\\\": \\\"npx --yes --package renovate@(?<currentValue>[^ ]+) renovate-config-validator renovate\\.json5\\\"",
      ],
      depNameTemplate: "renovate",
      datasourceTemplate: "npm",
    },
    {
      customType: "regex",
      description: "Update the Temurin JDK while preserving the mise provider prefix",
      managerFilePatterns: ["/^mise\\.toml$/"],
      matchStrings: [
        "java\\s*=\\s*\\\"temurin-(?<currentValue>[^\\\"]+)\\\"",
      ],
      depNameTemplate: "java",
      packageNameTemplate: "java-jdk",
      datasourceTemplate: "java-version",
    },
    {
      customType: "regex",
      description: "Update the pinned deployment image tags and digests",
      managerFilePatterns: ["/^config\\/deployment\\/images\\.env$/"],
      matchStrings: [
        "(?<envName>[A-Z0-9_]+_IMAGE)=(?<depName>[a-zA-Z0-9._/-]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
      autoReplaceStringTemplate:
        "{{{envName}}}={{{depName}}}:{{{newValue}}}@{{{newDigest}}}",
    },
    {
      customType: "regex",
      description: "Update the OpenAPI Generator used by the CLI wrapper",
      managerFilePatterns: ["/^openapitools\\.json$/"],
      matchStrings: ["\\\"version\\\": \\\"(?<currentValue>[^\\\"]+)\\\""],
      depNameTemplate: "OpenAPI Generator",
      packageNameTemplate: "org.openapitools:openapi-generator-cli",
      datasourceTemplate: "maven",
    },
    {
      customType: "regex",
      description: "Update the oasdiff binary downloaded by the API script",
      managerFilePatterns: ["/^scripts\\/api\\/oasdiff\\.sh$/"],
      matchStrings: ["OASDIFF_VERSION=\\\"(?<currentValue>[^\\\"]+)\\\""],
      depNameTemplate: "oasdiff/oasdiff",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
  ],
  packageRules: [
    {
      description: "Let the regex manager handle the provider-prefixed mise Java version",
      matchManagers: ["mise"],
      matchDepNames: ["java"],
      enabled: false,
    },
    {
      description: "Group non-major npm updates",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "dépendances npm non majeures",
    },
    {
      description: "Group non-major Maven and Maven Wrapper updates",
      matchManagers: ["maven", "maven-wrapper"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "dépendances Maven non majeures",
    },
    {
      description: "Group non-major GitHub Actions updates and digest pins",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
      groupName: "GitHub Actions non majeures",
    },
    {
      description: "Require explicit approval for every major update",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Require explicit approval for coordinated platform updates",
      matchPackageNames: [
        "node",
        "java-jdk",
        "caddy",
        "postgres",
        "eclipse-temurin",
        "org.openapitools:openapi-generator-cli",
        "/^io\\.quarkus(?:\\.|:)/",
        "/^com\\.stripe:/",
        "/^@stripe\\//",
      ],
      dependencyDashboardApproval: true,
    },
  ],
}
